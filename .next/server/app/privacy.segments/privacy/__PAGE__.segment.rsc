0:{"rsc":["$","$1","c",{"children":[["$","main",null,{"style":{"maxWidth":600,"margin":"0 auto","padding":"40px 20px","fontFamily":"-apple-system, sans-serif","color":"#1A1A1A","lineHeight":1.8},"children":[["$","h1",null,{"style":{"fontSize":24,"fontWeight":700,"marginBottom":20},"children":"Privacy Policy"}],["$","p",null,{"style":{"color":"rgba(0,0,0,0.5)","marginBottom":20},"children":"Last updated: July 2026"}],["$","h2",null,{"style":{"fontSize":18,"fontWeight":600,"marginTop":24,"marginBottom":8},"children":"What we collect"}],["$","p",null,{"children":"Cortilow collects the answers you provide during the cortisol assessment quiz (sleep habits, stress level, exercise frequency, diet, hydration, and nature exposure). This data is used solely to calculate your Cortisol Score and generate your personalized plan."}],["$","h2",null,{"style":{"fontSize":18,"fontWeight":600,"marginTop":24,"marginBottom":8},"children":"Photos"}],["$","p",null,{"children":"Selfies taken during the assessment are processed locally on your device and are never uploaded to our servers. Face Log photos are stored locally on your device only."}],["$","h2",null,{"style":{"fontSize":18,"fontWeight":600,"marginTop":24,"marginBottom":8},"children":"Email"}],["$","p",null,{"children":"If you provide your email address, it is used only for account authentication and to send you your cortisol report. We do not sell or share your email with third parties."}],["$","h2",null,{"style":{"fontSize":18,"fontWeight":600,"marginTop":24,"marginBottom":8},"children":"Payments"}],["$","p",null,{"children":"Payments are processed by Apple through the App Store. We do not collect or store any payment information (credit card numbers, billing address, etc.)."}],["$","h2",null,{"style":{"fontSize":18,"fontWeight":600,"marginTop":24,"marginBottom":8},"children":"Data storage"}],["$","p",null,{"children":"Your quiz responses and score are stored securely using Supabase (cloud database). Your daily mission progress, streak data, and photos are stored locally on your device."}],["$","h2",null,{"style":{"fontSize":18,"fontWeight":600,"marginTop":24,"marginBottom":8},"children":"Data deletion"}],["$","p",null,{"children":"You can request deletion of all your data at any time by contacting us at the email below. We will delete your data within 30 days of your request."}],["$","h2",null,{"style":{"fontSize":18,"fontWeight":600,"marginTop":24,"marginBottom":8},"children":"Third parties"}],["$","p",null,{"children":"We use the following third-party services: Supabase (database), Vercel (hosting), RevenueCat (subscription management), Apple (payments). Each has its own privacy policy."}],["$","h2",null,{"style":{"fontSize":18,"fontWeight":600,"marginTop":24,"marginBottom":8},"children":"Contact"}],["$","p",null,{"children":"For any privacy-related questions, contact us at: privacy@cortilow.com"}],["$","h2",null,{"style":{"fontSize":18,"fontWeight":600,"marginTop":24,"marginBottom":8},"children":"Changes"}],["$","p",null,{"children":"We may update this policy from time to time. Any changes will be posted on this page."}]]}],null,["$","$L2",null,{"children":["$","$3",null,{"name":"Next.MetadataOutlet","children":"$@4"}]}]]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"1rdIvv1hJcYj6kmXx8FYg"}
